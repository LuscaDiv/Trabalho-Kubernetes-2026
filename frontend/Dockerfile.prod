FROM node:20 AS build
WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend/. .
ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
# Reuse repo nginx config to proxy /api to the backend service inside the cluster
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Inject runtime env loader script into index.html and provide an entrypoint
COPY frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
RUN sed -i 's#</head>#<script src="/env.js"></script></head>#' /usr/share/nginx/html/index.html || true
EXPOSE 80
CMD ["/docker-entrypoint.sh"]
